/*
 * ECE 198 - Wearable exercise tracker (Arduino Uno R4 Minima)
 *
 * Worn on the hip. Guides the user through a CCCARE session (warm-up, cardio,
 * strength, cool-down), counts reps and checks form during the strength phase.
 *
 * Hardware:
 *   HC-SR04 ultrasonic  - TRIG D7, ECHO D8, points at the floor (hip height)
 *   BMX160 IMU          - I2C (A4 SDA / A5 SCL), powered from 3.3V
 *   SSD1306 OLED 128x64 - I2C (same bus, address 0x3C)
 *
 * Every 100 ms the sketch reads both sensors, streams one CSV line over USB
 * (used by ml/record.py to collect training data), runs the AI model if one
 * has been trained, and redraws the OLED.
 */

#include <Wire.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SSD1306.h>
#include <DFRobot_BMX160.h>

// model.h is generated by ml/train.py. If it doesn't exist yet the sketch
// still compiles and falls back to a simple tilt-threshold form check.
#if __has_include("model.h")
#include "model.h"
#define HAS_MODEL
#endif

#define SCREEN_WIDTH 128
#define SCREEN_HEIGHT 64
#define OLED_RESET -1  // OLED has no reset pin

// Standard hardware I2C constructor (uses A4 and A5 automatically)
Adafruit_SSD1306 display(SCREEN_WIDTH, SCREEN_HEIGHT, &Wire, OLED_RESET);

// Ultrasonic sensor pins
const int trig = 7;
const int echo = 8;

// Motion sensor (accelerometer + gyroscope + magnetometer)
DFRobot_BMX160 bmx160;

// Previous distance reading and its timestamp, used to compute velocity
float lastDist = 0.0;
unsigned long lastTime = 0;

const float static_dist = 5.0;        // cm/s; slower than this counts as "still"
const unsigned long PERIOD_MS = 100;  // loop period -> 10 samples per second
const float SMOOTH = 0.3;             // smoothing factor (0-1), lower = smoother but slower
float smoothTilt = 0.0;               // smoothed tilt angle in degrees

// Unit vector of gravity while standing upright, measured at startup.
// Tilt is the angle between the current gravity reading and this vector,
// so it works no matter how the sensor is mounted.
float refX = 0.0, refY = 0.0, refZ = 1.0;

// One stage of the exercise session
struct Phase {
  const char *name;       // shown on the top line of the OLED
  const char *hint;       // guidance from the dosage document
  unsigned long minutes;  // length of the phase
};

// Session structure from "Dosages & Exercise Sessions":
// 3-5 min warm-up, 15-30 min moderate cardio, strength, 3-5 min cool-down
const Phase PHASES[] = {
  {"WARM-UP", "Low intensity", 5},
  {"CARDIO", "40-60% HR reserve", 20},
  {"STRENGTH", "1-2 sets x 10-20", 30},
  {"COOL-DOWN", "Low intensity", 5},
};

const int PHASE_COUNT = sizeof(PHASES) / sizeof(PHASES[0]);
const int STRENGTH_PHASE = 2;   // index of the phase where reps are counted
unsigned long sessionStart = 0; // millis() when the session timer started

// Rep counter state
int reps = 0;
bool wentDown = false;          // true once a downward movement has been seen
const char *lastCategory = "";  // reps reset when the detected exercise changes

// Safety limits used for warnings (checked in every phase)
const float TILT_LIMIT = 15.0;   // degrees from the standing pose
const float SPEED_LIMIT = 50.0;  // cm/s of downward hip movement
const float CARRY_TILT = 10.0;   // carries should stay almost perfectly upright

// Maps each AI label to a functional category from
// "Sample Exercises and Categories", an optional form message, and which
// safety limits apply to that exercise (0 = don't check).
struct LabelInfo {
  const char *label;
  const char *category;
  const char *form;
  float maxTilt;
  float maxSpeed;
};

const LabelInfo LABEL_INFO[] = {
  {"squat_good", "Squat/Lunge", "Form: OK", TILT_LIMIT, SPEED_LIMIT},
  {"squat_lean", "Squat/Lunge", "!! LEANING !!", TILT_LIMIT, SPEED_LIMIT},
  {"squat_fast", "Squat/Lunge", "!! TOO FAST !!", TILT_LIMIT, SPEED_LIMIT},
  {"lunge", "Squat/Lunge", "", TILT_LIMIT, SPEED_LIMIT},
  {"hinge", "Hinge", "", 0, 0},                 // hinges tilt forward on purpose
  {"carry", "Carry", "", CARRY_TILT, 0},        // leaning sideways under the load
  {"floor", "Core", "", 0, 0},                  // lying down, tilt is meaningless
  {"idle", "Rest/Upper body", "", TILT_LIMIT, 0},  // e.g. leaning back during presses
};

// Returns the table entry for an AI label, or nullptr if it isn't listed
const LabelInfo *findLabel(const char *label) {
  for (const LabelInfo &info : LABEL_INFO) {
    if (strcmp(info.label, label) == 0) return &info;
  }
  return nullptr;
}

#ifdef HAS_MODEL
Eloquent::ML::Port::RandomForest formModel;   // random forest exported by train.py
float samples[MODEL_WINDOW][MODEL_CHANNELS];  // last 3 s of sensor rows, oldest first
long sampleCount = 0;
const char *formLabel = "...";                // latest prediction

// Summarizes the sample window into features and runs the model.
// For each sensor channel: mean, standard deviation, min, max and average
// change per step. This MUST match features() in ml/train.py exactly.
void classifyForm() {
  float features[MODEL_CHANNELS * 5];
  for (int c = 0; c < MODEL_CHANNELS; c++) {
    float sum = 0, lo = samples[0][c], hi = samples[0][c];
    for (int i = 0; i < MODEL_WINDOW; i++) {
      sum += samples[i][c];
      lo = fminf(lo, samples[i][c]);
      hi = fmaxf(hi, samples[i][c]);
    }
    float mean = sum / MODEL_WINDOW;
    float sq = 0, step = 0;
    for (int i = 0; i < MODEL_WINDOW; i++) {
      sq += (samples[i][c] - mean) * (samples[i][c] - mean);
      if (i > 0) step += fabsf(samples[i][c] - samples[i - 1][c]);
    }
    float *f = &features[c * 5];
    f[0] = mean;
    f[1] = sqrtf(sq / MODEL_WINDOW);  // population std, same as numpy
    f[2] = lo;
    f[3] = hi;
    f[4] = step / (MODEL_WINDOW - 1); // how fast the value is changing
  }
  formLabel = formModel.predictLabel(features);
}

// Adds one sensor row to the sliding window and classifies every MODEL_HOP
// samples (once per second) after the window has filled up.
void addSample(const float *row) {
  memmove(samples[0], samples[1], sizeof(float) * MODEL_CHANNELS * (MODEL_WINDOW - 1));
  memcpy(samples[MODEL_WINDOW - 1], row, sizeof(float) * MODEL_CHANNELS);
  sampleCount++;
  if (sampleCount >= MODEL_WINDOW && (sampleCount - MODEL_WINDOW) % MODEL_HOP == 0) {
    classifyForm();
  }
}
#endif

void setup() {
  Serial.begin(115200);

  // Start the physical I2C hardware bus
  Wire.begin();
  delay(100);

  pinMode(trig, OUTPUT);
  pinMode(echo, INPUT);

  // Initialize OLED (Address 0x3C on shared hardware pins A4/A5).
  // If it fails there is no screen to report on, so report over serial and stop.
  if(!display.begin(SSD1306_SWITCHCAPVCC, 0x3C)) {
    Serial.println(F("OLED allocation failed"));
    while(1);
  }

  display.clearDisplay();
  display.setTextSize(1);
  display.setTextColor(SSD1306_WHITE);
  display.setCursor(0, 0);
  display.println("System Initializing...");
  display.display();
  delay(1000);

  // Initialize IMU (Also on shared hardware pins A4/A5).
  // Stop with an on-screen error rather than running with bad tilt data.
  if (bmx160.begin() != true) {
    display.clearDisplay();
    display.setCursor(0, 0);
    display.println("BMX160 Init Failed!");
    display.println("Check A4/A5 split.");
    display.display();
    while(1);
  }

  // Tilt calibration: give the user 1.5 s to stand still, then average
  // 20 accelerometer readings (1 s) to find which way gravity points.
  display.clearDisplay();
  display.setCursor(0, 0);
  display.println("Stand upright");
  display.println("and still...");
  display.display();
  delay(1500);
  float sx = 0, sy = 0, sz = 0;
  for (int i = 0; i < 20; i++) {
    sBmx160SensorData_t m, g, a;
    bmx160.getAllData(&m, &g, &a);
    sx += a.x;
    sy += a.y;
    sz += a.z;
    delay(50);
  }
  // Normalize to a unit vector; keep the default (0,0,1) if the sensor read all zeros
  float norm = sqrt(sx * sx + sy * sy + sz * sz);
  if (norm > 0) {
    refX = sx / norm;
    refY = sy / norm;
    refZ = sz / norm;
  }

  // Prime the tracking metrics with a first distance reading
  digitalWrite(trig, LOW);
  delayMicroseconds(2);
  digitalWrite(trig, HIGH);
  delayMicroseconds(10);
  digitalWrite(trig, LOW);

  // Speed * time / 2 (divide by 2 because travel there and back, 0.034 is cm/microsecond).
  // The 30 ms timeout (~5 m) stops a missed echo from blocking for a full second.
  lastDist = pulseIn(echo, HIGH, 30000) * 0.034 / 2;
  lastTime = millis();
  sessionStart = lastTime;
}

void loop() {
  unsigned long currentTime = millis();
  float timeDelta = (currentTime - lastTime) / 1000.0;

  // 1. Measure Ultrasonic Distance (10 us trigger pulse, then time the echo)
  digitalWrite(trig, LOW);
  delayMicroseconds(2);
  digitalWrite(trig, HIGH);
  delayMicroseconds(10);
  digitalWrite(trig, LOW);

  long dur = pulseIn(echo, HIGH, 30000);
  float rawDist = dur * 0.034 / 2;

  // Exponential smoothing to reduce noise. A timeout (rawDist == 0) keeps the
  // previous value instead of dropping to 0 cm.
  float currentDist = lastDist;
  if (rawDist > 0) {
    currentDist = lastDist > 0 ? lastDist + SMOOTH * (rawDist - lastDist) : rawDist;
  }

  // 2. Calculate Downward Velocity (cm/s, positive = moving down)
  float velocity = 0.0;
  if (timeDelta > 0 && lastDist > 0) {
    velocity = (lastDist - currentDist) / timeDelta;
  }

  lastDist = currentDist;
  lastTime = currentTime;

  // 3. Fetch IMU Data from Shared Bus
  sBmx160SensorData_t Omagn, Ogyro, Oaccel;
  bmx160.getAllData(&Omagn, &Ogyro, &Oaccel);

  // Tilt = angle between current gravity and the standing reference:
  // cos(angle) = (a . ref) / |a|. Clamp to [-1, 1] so rounding can't break acos.
  float mag = sqrt(Oaccel.x * Oaccel.x + Oaccel.y * Oaccel.y + Oaccel.z * Oaccel.z);
  float cosTilt = mag > 0 ? (Oaccel.x * refX + Oaccel.y * refY + Oaccel.z * refZ) / mag : 1.0;
  float rawTilt = acos(constrain(cosTilt, -1.0f, 1.0f)) * 180.0 / PI;
  smoothTilt += SMOOTH * (rawTilt - smoothTilt);
  float tiltAngle = smoothTilt;

  // Stream one CSV line per sample: D,ax,ay,az,gx,gy,gz,dist,tilt
  // ml/record.py saves these lines as labeled training data.
  float row[8] = {Oaccel.x, Oaccel.y, Oaccel.z, Ogyro.x, Ogyro.y, Ogyro.z, currentDist, tiltAngle};
  Serial.print('D');
  for (float v : row) {
    Serial.print(',');
    Serial.print(v, 3);
  }
  Serial.println();

#ifdef HAS_MODEL
  addSample(row);
#endif

  // 4. Session phase and countdown: walk through PHASES subtracting each
  // phase's length until we find the one we're in.
  unsigned long elapsed = (currentTime - sessionStart) / 1000;
  int phase = 0;
  while (phase < PHASE_COUNT && elapsed >= PHASES[phase].minutes * 60) {
    elapsed -= PHASES[phase].minutes * 60;
    phase++;
  }
  bool strength = phase == STRENGTH_PHASE;

  // Look up the detected exercise category, form message and safety limits.
  // Without a model (or for an unknown label) the general limits apply.
  const char *category = "";
  const char *form = "";
  float maxTilt = TILT_LIMIT;
  float maxSpeed = SPEED_LIMIT;
#ifdef HAS_MODEL
  const LabelInfo *info = findLabel(formLabel);
  category = info ? info->category : formLabel;
  if (info) {
    form = info->form;
    maxTilt = info->maxTilt;
    maxSpeed = info->maxSpeed;
  }
#endif

  // Pick one warning to show, most specific first: the AI's form warning,
  // then the tilt limit, then the downward speed limit.
  const char *warning = form[0] == '!' ? form : "";
  if (!warning[0] && maxTilt > 0 && tiltAngle > maxTilt) warning = "!! EXCESSIVE LEAN !!";
  if (!warning[0] && maxSpeed > 0 && velocity > maxSpeed) warning = "!! TOO FAST !!";

  // A new exercise (or rest between sets) starts a new rep count
  if (strcmp(category, lastCategory) != 0) {
    reps = 0;
    wentDown = false;
    lastCategory = category;
  }

  // Rep counting: a rep is a downward movement followed by an upward one
  if (strength) {
    if (velocity > static_dist) {
      wentDown = true;
    } else if (velocity < -static_dist && wentDown) {
      reps++;
      wentDown = false;
    }
  }

  // 5. Update the OLED Screen Interface
  display.clearDisplay();
  display.setCursor(0, 0);
  if (phase >= PHASE_COUNT) {
    display.println("SESSION DONE");
  } else {
    // Top line: phase name and time left, e.g. "CARDIO     14:32"
    unsigned long left = PHASES[phase].minutes * 60 - elapsed;
    char line[22];
    snprintf(line, sizeof(line), "%-10s %02lu:%02lu", PHASES[phase].name, left / 60, left % 60);
    display.println(line);

    // Second line: detected exercise during strength, otherwise the phase guidance
    display.setCursor(0, 10);
#ifdef HAS_MODEL
    if (strength) {
      display.print("AI: ");
      display.println(category);
    } else {
      display.println(PHASES[phase].hint);
    }
#else
    display.println(PHASES[phase].hint);
#endif
  }

  // Third line: warnings in every phase, drawn inverted so they stand out.
  // With no warning, show "Form: OK" during strength if the AI reports it.
  display.setCursor(0, 20);
  if (warning[0]) {
    display.setTextColor(SSD1306_BLACK, SSD1306_WHITE);
    display.println(warning);
    display.setTextColor(SSD1306_WHITE);
  } else if (strength) {
    display.println(form);
  }

  if (strength) {
    display.setCursor(0, 34);
    display.print("Reps: ");
    display.print(reps);
    display.println(" / 10-20");  // target reps per set from the dosage document
  }

  // Bottom section: live sensor readings
  display.drawFastHLine(0, 44, 128, SSD1306_WHITE);
  display.setCursor(0, 47);
  display.print("Tilt ");
  display.print(tiltAngle, 0);
  display.print("  Dist ");
  display.print(currentDist, 0);
  display.setCursor(0, 56);
  if (velocity > static_dist) {
    display.println("Moving: DOWN");
  } else if (velocity < -static_dist) {
    display.println("Moving: UP");
  } else {
    display.println("Moving: still");
  }

  display.display();

  // Wait out the rest of the 100 ms period (millis-based, keeps a steady sample rate)
  while (millis() - currentTime < PERIOD_MS) {}
}
